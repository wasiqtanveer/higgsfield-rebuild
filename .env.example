# Copy to `.env.local` and fill in. `.env.local` is gitignored; this file is not,
# so it must never carry a real value.

# Cloudflare Workers AI — runs FLUX-1-schnell. Account ID is in the dashboard
# URL; the token comes from My Profile -> API Tokens, Workers AI template, Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Supabase — Postgres for prompts and lineage, Storage for the images.
# Project Settings -> API. The service_role key is secret and is only ever read
# server-side inside /api; it must never reach the browser bundle, which is why
# neither of these carries Vite's VITE_ prefix.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
